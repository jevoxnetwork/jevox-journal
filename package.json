{
  "name": "jevox-journal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs --pages",
    "db:generate": "drizzle-kit generate",
    "deploy": "wrangler deploy --config wrangler.jsonc --keep-vars",
    "test": "node --test test/*.test.mjs",
    "check": "node --check worker/index.mjs"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.27.0",
    "miniflare": "^4.20260730.0"
  }
}
