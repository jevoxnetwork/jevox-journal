# Local application address; must match the redirect URLs registered with providers.
PUBLIC_URL=http://localhost:5173
HOST=127.0.0.1
PORT=5173

# Telegram: BotFather -> your bot -> Login Widget -> Switch to OpenID Connect Login.
# This is the Login Client Secret, NOT the Bot API token.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Callback is derived from PUBLIC_URL: /auth/telegram/callback

# VK ID: Web application, Authorization Code + PKCE.
VK_CLIENT_ID=
# Optional confidential application secret, when required by your VK application.
VK_CLIENT_SECRET=
# Callback is derived from PUBLIC_URL: /auth/vk/callback

# Only verified provider IDs can grant access; no first-user auto-admin.
# Comma-separated numeric public Telegram/VK user IDs, not usernames.
ADMIN_TELEGRAM_IDS=
ADMIN_VK_IDS=
STAFF_TELEGRAM_IDS=
STAFF_VK_IDS=

